import { Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    in property <float> scale: 1;

    max-width: 600px * scale;
    max-height: 450px * scale;
    min-width: 600px * scale;
    min-height: 450px * scale;

    in property <bool> hovering;
    callback add-clicked();

    Rectangle {
        background: hovering ? #2f2f2f : #1c1c1c;

        Image {
            width: 128px * scale;
            height: 128px * scale;
            source: @image-url("assets/uplaod.png");
            colorize: #545454;
        }
    }

    Button {
        x: 8px * scale;
        y: 8px * scale;
        text: "+";
        clicked => { root.add-clicked(); }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("assets/uplaod.png");
    tooltip: "background_gif";

    callback quit();
    callback open();
    clicked => { root.open(); }

    Menu {
        MenuItem {
            title: "Open";
            activated => { root.open(); }
        }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

export component GifWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "background_gif";

    in property <image> frame;

    preferred-width: frame.width * 1phx;
    preferred-height: frame.height * 1phx;

    Image {
        source: frame;
        width: 100%;
        height: 100%;
    }
}
