import { Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    in property <float> scale: 1;

    max-width: 600px * scale;
    max-height: 450px * scale;
    min-width: 600px * scale;
    min-height: 450px * scale;

    in property <bool> hovering;
    in-out property <bool> on-top;
    callback add-clicked();

    Rectangle {
        background: hovering ? #2f2f2f : #1c1c1c;

        Image {
            width: 128px * scale;
            height: 128px * scale;
            source: @image-url("assets/uplaod.png");
            colorize: #545454;
        }
    }

    add-button := Button {
        x: 8px * scale;
        y: 8px * scale;
        text: "+";
        clicked => { root.add-clicked(); }
    }

    level-button := Button {
        x: root.width - self.width - 8px * scale;
        y: 8px * scale;
        width: add-button.width;
        height: add-button.height;
        clicked => { root.on-top = !root.on-top; }
    }

    Image {
        width: 16px * scale;
        height: 16px * scale;
        x: level-button.x + (level-button.width - self.width) / 2;
        y: level-button.y + (level-button.height - self.height) / 2;
        source: root.on-top ? @image-url("assets/arrow_up.png") : @image-url("assets/arrow_down.png");
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("assets/uplaod.png");
    tooltip: "background_gif";

    in-out property <bool> clickthrough: true;
    changed clickthrough => { root.clickthrough-toggled(self.clickthrough); }
    callback clickthrough-toggled(bool);
    callback quit();
    callback open();
    clicked => { root.open(); }

    Menu {
        MenuItem {
            title: "Open";
            activated => { root.open(); }
        }

        MenuItem {
            title: "Toggle click through";
            checkable: true;
            checked <=> root.clickthrough;
        }

        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

export component GifWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "background_gif";

    in property <image> frame;

    preferred-width: frame.width * 1phx;
    preferred-height: frame.height * 1phx;

    Image {
        source: frame;
        width: 100%;
        height: 100%;
    }
}
