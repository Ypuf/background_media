import { Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    max-width: 600px;
    max-height: 450px;
    min-width: 600px;
    min-height: 450px;

    in property <bool> hovering;
    callback add-clicked();

    Rectangle {
        background: hovering ? #2f2f2f : #1c1c1c;

        Image {
            width: 128px;
            height: 128px;
            source: @image-url("assets/uplaod.png");
            colorize: #545454;
        }
    }

    Button {
        x: 8px;
        y: 8px;
        text: "+";
        clicked => { root.add-clicked(); }
    }
}

export component GifWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "background_gif";

    in property <image> frame;

    width: frame.width * 1phx;
    height: frame.height * 1phx;

    Image {
        source: frame;
        width: 100%;
        height: 100%;
    }
}
